///|
/// Fictional fixtures, not a travel guide or scraped commercial catalogue.
fn place(
  id : String,
  name : String,
  city : String,
  district : String,
  tags : Array[String],
  cost : Int,
  duration : Int,
  indoor : Bool,
  family : Bool,
  open : Int,
  close : Int,
) -> @engine.Place {
  {
    id,
    name,
    city,
    district,
    tags,
    cost,
    duration,
    indoor,
    family,
    open,
    close,
    source: "MoonTrip 原创虚构演示数据 v1；非真实景点报价/营业时间",
    url: "",
    kind: "sight",
  }
}

