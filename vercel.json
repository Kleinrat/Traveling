{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No runtime dependencies'",
  "buildCommand": "bash scripts/build_render.sh && mkdir -p public && cp server/index.html public/index.html",
  "outputDirectory": "public",
  "regions": [
    "hkg1"
  ],
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "web/engine.js"
    }
  }
}
